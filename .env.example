#--------------------------------------------------------------------
# Chege Photos Platform — Unified Environment Template
# Copy this file to .env before running: docker compose up -d
# or running: bash scripts/deploy.sh
#--------------------------------------------------------------------

# ── Production Standard Host Ports & Orchestration ────────────────
WEB_PORT=80
DB_PORT=3306
ML_PORT=8000
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Database Credentials ──────────────────────────────────────────
DB_HOST=mysql
DB_NAME=db_chege_photos
DB_USER=root
DB_ROOT_PASSWORD=root_password

# ── Redis In-Memory Store & Queue Broker ──────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Inter-Service Security & Endpoints ────────────────────────────
ML_URL=http://ml:8000
ML_API_KEY=my_super_secret_shared_token_key_123!

# ── Web Application (CodeIgniter 4) ───────────────────────────────
CI_ENVIRONMENT=development
app.baseURL=http://localhost/
app.forceGlobalSecureRequests=false
encryption.key=

# Web Seeder Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=admin_password
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=SuperAdmin@2024!
SUPERADMIN_USERNAME=superadmin

# ── Machine Learning & Vector Store ───────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=face_embeddings

FACE_MODEL_PACK=buffalo_l
FACE_DET_THRESH=0.5
INCLUDE_SENSITIVE_ATTRIBUTES=false
HDBSCAN_MIN_CLUSTER_SIZE=2
HDBSCAN_MIN_SAMPLES=1
CLUSTER_METRIC=cosine
SCAN_STALE_TIMEOUT_SEC=300
LOG_LEVEL=info
