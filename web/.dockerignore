# Environments
.env
.env.*

# IDEs
.idea/
.vscode/

# Git
.git/
.gitignore

# Dependencies
vendor/
node_modules/
__pycache__/
*.pyc
.venv/
venv/
env/

# Build
build/
dist/

# OS
.DS_Store

# Media Uploads & Thumbnails (Do not send gigabytes of user photos into Docker build context)
public/uploads/*
!public/uploads/.gitkeep
public/thumbnails/*
!public/thumbnails/.gitkeep

# Runtime writable directories
writable/cache/*
!writable/cache/.gitkeep
writable/logs/*
!writable/logs/.gitkeep
writable/session/*
!writable/session/.gitkeep
writable/debugbar/*
writable/uploads/*

# Test suites & artifacts
tests/
phpunit.xml*
.phpunit.cache/
*.log
