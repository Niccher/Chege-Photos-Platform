!web/writable/debugbar/.gitkeep
!web/writable/logs/.gitkeep
!web/writable/session/.gitkeep
!web/writable/uploads/.gitkeep
!web/writable/exports/.gitkeep
!web/writable/backups/.gitkeep

# Public user-uploaded content
web/public/uploads/*
web/public/thumbnails/*
!web/public/uploads/.gitkeep
!web/public/thumbnails/.gitkeep

# ML & Models (Stored in minio://chege-models/, never committed to Git)
ml/.venv/
ml/venv/
ml/__pycache__/
ml/*.pyc
ml/models/
ml/wheels/
wheels/
*.whl
*.onnx
*.safetensors
*.bin
*.pt
*.gguf

# Writable vault, downloads, MkDocs build & backups
web/writable/vault/*
web/writable/downloads/*
!web/writable/vault/.gitkeep
!web/writable/downloads/.gitkeep
site/
*.sql.gz
*.bak

