build/
dist/
*.apk
*.aab
*.jar
*.war

# Logs and DB
logs/
*.log
*.sqlite
*.sqlite3

# Web (CodeIgniter 4) Writable and Uploads
web/vendor/
web/writable/cache/*
web/writable/debugbar/*
web/writable/logs/*
web/writable/session/*
web/writable/uploads/*
web/writable/exports/*
web/writable/backups/*
